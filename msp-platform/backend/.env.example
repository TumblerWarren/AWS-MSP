# --- Database ---
MSP_DATABASE_URL=sqlite:///./msp.db

# --- Target Infrastructure Repo (GitHub) ---
MSP_GITHUB_REPO=TumblerWarren/AWS-MSP
MSP_GITHUB_TOKEN=
MSP_GITHUB_DEFAULT_BRANCH=master
# Additional registered Terraform repositories and their deployment branches.
MSP_TERRAFORM_REPOSITORIES={}
MSP_LOCAL_INFRA_REPO_PATH=../../msp-sandbox-infra
# Bucket from the platform deployment output. Local AWS credentials need read access.
MSP_DRIFT_REPORT_BUCKET=

# --- AWS & Investigation Role ---
MSP_AWS_REGION=ap-south-1
# Supports either:
#   1) IAM Access Key + Secret Key (leave AWS_SESSION_TOKEN empty), OR
#   2) Temporary STS credentials (AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + AWS_SESSION_TOKEN)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Role ARN created by msp-platform/infra (read-only + explicit Deny on secrets & state)
MSP_INVESTIGATOR_ROLE_ARN=

# --- Investigation Agent (AWS Strands Agents SDK on Bedrock) ---
# The default Sonnet profile calls Bedrock in Sydney. Custom models default to MSP_AWS_REGION.
MSP_BEDROCK_REGION=
MSP_STRANDS_MODEL_ID=au.anthropic.claude-sonnet-4-6
# Comma-separated AWS Labs MCP servers mounted via uvx into the Strands agent.
# Both run strictly read-only under MSP_INVESTIGATOR_ROLE_ARN.
MSP_AWS_MCP_ENABLED=true

# --- Terraform Patcher Agent (Claude Agent SDK) ---
# Uses Bedrock when MSP_CLAUDE_USE_BEDROCK=true, otherwise ANTHROPIC_API_KEY
MSP_CLAUDE_USE_BEDROCK=true
MSP_CLAUDE_MODEL=au.anthropic.claude-sonnet-4-6
# Optional: override base URL if routing through an Anthropic-compatible proxy
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=

# --- Optional: force local simulation for CI/GitHub actions before connecting GitHub ---
MSP_DRY_RUN_GITHUB=false
